// this is a SL comment

print("hi3: from {a} and {b}\n", a=10, b=12);

var idx = 2;
while(idx < 10) {
    idx = idx + 1;
    print("hi4:{a}\n", a=idx);
}
print("hi5\n");

(int i, int j) add(int x, int y) {
    print("adding:{x} + {y}\n", x=x, y=y);
    return (i=x + y, j = y - x);
}

var r = add(x=1, y=2);
print("added:i={i}, j={j}\n", r);
